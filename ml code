
# Import libraries
from pathlib import Path

import joblib
from sklearn.datasets import load_iris
from sklearn.neighbors import KNeighborsClassifier

MODEL_PATH = Path(__file__).with_name("iris_model.joblib")

# Load the dataset
data = load_iris()

# Input and output
X = data.data
y = data.target

# Create the model
model = KNeighborsClassifier(n_neighbors=3)

# Train the model
model.fit(X, y)

# Save the trained model and its class names for the frontend
joblib.dump(
    {"model": model, "target_names": data.target_names.tolist()},
    MODEL_PATH,
)

# Predict flower species
result = model.predict([[5.1, 3.5, 1.4, 0.2]])

# Display result
print("Flower Name:", data.target_names[result[0]])
print("Model saved to:", MODEL_PATH)
